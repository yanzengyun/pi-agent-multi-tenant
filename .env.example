ASSISTANT_HOST=127.0.0.1
ASSISTANT_PORT=32214
ASSISTANT_ENGINE=mock
ASSISTANT_DATA_DIR=./.data
# Supply a unique password of at least 12 characters on first startup.
ASSISTANT_ADMIN_PASSWORD=
# For pi mode, point at the installed 1.1.0 SDK entry or install the peer locally.
# Leave empty to use the pinned sdk-runtime after npm run setup:pi.
PI_SDK_MODULE=
ASSISTANT_MODELS_FILE=./models.json
# Default: minimax-cn. To switch to DeepSeek, use deepseek / deepseek-flash.
ASSISTANT_PROVIDER=minimax-cn
ASSISTANT_MODEL=MiniMax-M3.1-Flash-Preview
MINIMAX_CN_API_KEY=
DEEPSEEK_API_KEY=
ASSISTANT_SEARCH=off
# Set these when publishing through an HTTPS gateway later.
ASSISTANT_SECURE_COOKIES=off
ASSISTANT_ORIGIN=
# Optional single path segment for the authenticated gateway, e.g. /assistant.
ASSISTANT_BASE_PATH=
# Explicitly opt into real WeChat QR requests; no bindings are imported.
ASSISTANT_WECHAT=off
# JSON with protectedBots/protectedUsers to exclude the existing personal account.
ASSISTANT_WECHAT_PROTECTION=
# Private JSON: baseUrl, publicUrl, username, password for the SB administrator.
ASSISTANT_SB_CONFIG=

# Optional private Unix socket of the separately deployed isolated command runner.
ASSISTANT_SANDBOX_SOCKET=
